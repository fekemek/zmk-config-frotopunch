#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                     w   h    x    y    rot    rx    ry
            = <&key_physical_attrs 100 100    0   50      0     0     0>
            , <&key_physical_attrs 100 100  100   30      0     0     0>
            , <&key_physical_attrs 100 100  200   10      0     0     0>
            , <&key_physical_attrs 100 100  300    0      0     0     0>
            , <&key_physical_attrs 100 100  400   10      0     0     0>
            , <&key_physical_attrs 100 100  500   20      0     0     0>
            , <&key_physical_attrs 100 100  800   20      0     0     0>
            , <&key_physical_attrs 100 100  900   10      0     0     0>
            , <&key_physical_attrs 100 100 1000    0      0     0     0>
            , <&key_physical_attrs 100 100 1100   10      0     0     0>
            , <&key_physical_attrs 100 100 1200   30      0     0     0>
            , <&key_physical_attrs 100 100 1300   50      0     0     0>

            , <&key_physical_attrs 100 100    0  150      0     0     0>
            , <&key_physical_attrs 100 100  100  130      0     0     0>
            , <&key_physical_attrs 100 100  200  110      0     0     0>
            , <&key_physical_attrs 100 100  300  100      0     0     0>
            , <&key_physical_attrs 100 100  400  110      0     0     0>
            , <&key_physical_attrs 100 100  500  120      0     0     0>
            , <&key_physical_attrs 100 100  800  120      0     0     0>
            , <&key_physical_attrs 100 100  900  110      0     0     0>
            , <&key_physical_attrs 100 100 1000  100      0     0     0>
            , <&key_physical_attrs 100 100 1100  110      0     0     0>
            , <&key_physical_attrs 100 100 1200  130      0     0     0>
            , <&key_physical_attrs 100 100 1300  150      0     0     0>

            , <&key_physical_attrs 100 100    0  250      0     0     0>
            , <&key_physical_attrs 100 100  100  230      0     0     0>
            , <&key_physical_attrs 100 100  200  210      0     0     0>
            , <&key_physical_attrs 100 100  300  200      0     0     0>
            , <&key_physical_attrs 100 100  400  210      0     0     0>
            , <&key_physical_attrs 100 100  500  220      0     0     0>
            , <&key_physical_attrs 100 100  800  220      0     0     0>
            , <&key_physical_attrs 100 100  900  210      0     0     0>
            , <&key_physical_attrs 100 100 1000  200      0     0     0>
            , <&key_physical_attrs 100 100 1100  210      0     0     0>
            , <&key_physical_attrs 100 100 1200  230      0     0     0>
            , <&key_physical_attrs 100 100 1300  250      0     0     0>

            , <&key_physical_attrs 100 100  350  375      0     0     0>
            , <&key_physical_attrs 100 150  475  325   1500   450   410>
            , <&key_physical_attrs 100 100  600  375   3000   540   430>
            , <&key_physical_attrs 100 100  800  375 (-3000)  960   430>
            , <&key_physical_attrs 100 150  925  325 (-1500) 1050   410>
            , <&key_physical_attrs 100 100 1050  375      0     0     0>
        ;
    };
};